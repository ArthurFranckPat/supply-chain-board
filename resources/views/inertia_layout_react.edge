<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title inertia>Ordonnancement</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#141414" />

  {{-- Trois webfonts, via @fontsource et bundlées par Vite : Plus Jakarta Sans
       (thème airbnb, substitut de Cereal), Inter + JetBrains Mono (thème cursor).
       Aucune pile système en rendu nominal — le parc est mixte Windows + Mac et
       doit rendre à l'identique. Icônes via lucide-react (SVG). Aucune webfont
       Google — Material Symbols retirée (Lot A redesign Airbnb, 2026-07-20). --}}

  @inertiaHead()
  @viteReactRefresh()
  @vite(['inertia-react/app.tsx'])
</head>
<body>
  @inertia()
</body>
</html>
