<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title inertia>Ordonnancement</title>

  {{-- Thème Airbnb : une seule webfont, Plus Jakarta Sans Variable (substitut de
       Cereal), via @fontsource et bundlée par Vite. Le thème cursor n'en charge
       aucune (pile système). Icônes via lucide-react (SVG). Aucune webfont
       Google — Material Symbols retirée (Lot A redesign Airbnb, 2026-07-20). --}}

  @inertiaHead()
  @viteReactRefresh()
  @vite(['inertia-react/app.tsx'])
</head>
<body>
  @inertia()
</body>
</html>
